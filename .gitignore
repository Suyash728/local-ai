# This repo tracks documentation and configs ONLY.
# Never weights, never venvs, never generated output.

#---Environment variables---
.env

# --- Python venvs ---
comfy-venv/
comfy-venv-cu130/
/agent-venv/
/speech-venv/
/openwebui-venv/
.venv/
venv/
__pycache__/
*.pyc

# --- Model weights (all formats, anywhere) ---
models/
FLUX.1-dev-NVFP4/
*.safetensors
*.gguf
*.ckpt
*.pt
*.pth
*.bin
*.onnx

# --- Application checkouts (upstream repos, not ours) ---
ComfyUI/
# anchored: an unanchored `ai-toolkit/` also matches configs/ai-toolkit/,
# which holds training configs we DO want tracked.
/ai-toolkit/
/localai/
/localagi/
/anythingllm/
# userspace Go toolchain, installed only to build LocalAGI from source
/go/

# --- secrets ---
# open-webui drops this in its working directory on first start
.webui_secret_key

# --- Caches & generated output ---
# deep_research reports + its SQLite store (generated, not docs)
/research/
.cache/
output/
temp/
input/
*.log

# --- HF cache leftovers ---
*.incomplete
*.lock

# scratch from the model pulls
.pull-models.sh
.pull-models.log

# Track B scratch
.trackb-*.sh
.trackb-*.log
.comfy-reqs-notorch.txt
.trackb2-*.sh
.trackb2-*.log
.trackb3-*.sh
.trackb3-*.log
.trackb4-*.sh
.trackb4-*.log
.trackb5-*.sh
.trackb5-*.log
